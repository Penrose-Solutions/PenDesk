{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PenDesk",
  "version": "1.0.0",
  "identifier": "com.penrose.pendesk",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PenDesk Remote Desktop",
        "url": "index.html?app=desktop",
        "width": 1050,
        "height": 720,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "RWQCc5XROM++DIdHnQYYDoBNYf/T+VI4aMyfMnSUdZaZlghwXKPIdSWN",
      "endpoints": [
        "https://hjelp.penrose.no/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
