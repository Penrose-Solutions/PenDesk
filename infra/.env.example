# ============================================================
# PenDesk VPS Infrastructure Environment Variables
# Copy to .env and replace with your actual values:
# cp .env.example .env
# ============================================================

# Your domain (e.g., pendesk.yourdomain.com)
DOMAIN=pendesk.yourdomain.com

# Subdomain for STUN/TURN (e.g., turn.yourdomain.com)
TURN_DOMAIN=turn.yourdomain.com

# Shared secret for Coturn and Signaling Server (generate with: openssl rand -hex 32)
TURN_SECRET=replace_with_a_secure_random_64_char_hex_secret

# Contact email for Let's Encrypt TLS certificate expiry notices
ACME_EMAIL=admin@yourdomain.com
